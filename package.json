{
  "name": "epistemics-playground",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build": "bun run build:connector && vite build --config web/vite.config.ts",
    "build:connector": "bun build connector/connect.ts --target=node --outfile web/public/connect.mjs",
    "server": "bun run server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test tests",
    "check": "bun run typecheck && bun test tests",
    "prepare": "git config core.hooksPath .githooks",
    "migrate": "bun run scripts/migrate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@dnd-kit/core": "6.3.1",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "fractional-indexing": "3.2.0",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.0",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
